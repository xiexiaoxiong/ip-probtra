# 复制为 .env.prod.local。不要放入任何测试前缀、5201/5209 或测试凭据。
INVALIDITY_ENV=prod
INVALIDITY_PORT=5109
INVALIDITY_DATABASE_URL=postgresql+psycopg2://patent:REPLACE_WITH_PROD_DB_PASSWORD@127.0.0.1:5432/patent
INVALIDITY_DATABASE_SCHEMA=invalidity_prod
INVALIDITY_ARTIFACT_ROOT=/Users/xiexiaoxiong/Documents/patent/5-invalidity-search-prod/.data/invalidity/prod
INVALIDITY_ALLOWED_SOURCE_ROOTS=/Users/xiexiaoxiong/Documents/patent/5-invalidity-search-prod/.data/uploads/prod

INVALIDITY_PROD_API_URL=http://127.0.0.1:5109
INVALIDITY_PROD_API_TOKEN=
INVALIDITY_PROD_MODULE1_API_URL=http://127.0.0.1:5101/run
# 若正式模块一支持 Bearer，请填写独立 token 并把 mode 改为 bearer；否则必须显式保留 legacy_unauthenticated。
INVALIDITY_PROD_MODULE1_API_TOKEN=
INVALIDITY_PROD_MODULE1_AUTH_MODE=legacy_unauthenticated
# 专利候选发现统一使用智慧芽；正式 Key 必须与测试 Key 隔离，缺失时拒绝启动。
INVALIDITY_PROD_PATENT_PROVIDER=patsnap
INVALIDITY_PROD_PATSNAP_API_KEY=
INVALIDITY_PROD_PATSNAP_BASE_URL=https://connect.zhihuiya.com
INVALIDITY_PROD_PATSNAP_COUNT_PATH=/search/patent/query-search-count/v2
INVALIDITY_PROD_PATSNAP_SEARCH_PATH=/search/patent/query-search-patent/v2
INVALIDITY_PROD_EPO_OPS_KEY=
INVALIDITY_PROD_EPO_OPS_SECRET=
INVALIDITY_PROD_NPL_PROVIDER=arxiv
INVALIDITY_PROD_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
INVALIDITY_PROD_LLM_API_KEY=REPLACE_WITH_PROD_GLM_KEY
INVALIDITY_PROD_LLM_MODEL=glm-4.6v

INVALIDITY_MAX_ROUNDS=5
INVALIDITY_MAX_CANDIDATES_PER_QUERY=5
INVALIDITY_WORKER_POLL_SECONDS=2
INVALIDITY_JOB_LEASE_SECONDS=900
INVALIDITY_SOURCE_FETCH_TIMEOUT_SECONDS=30
INVALIDITY_SOURCE_MAX_BYTES=52428800
INVALIDITY_IMAGE_MAX_BYTES=15728640
INVALIDITY_SOURCE_MAX_REDIRECTS=5

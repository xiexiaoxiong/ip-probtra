# 复制为 .env.test.local。不要使用正式无效服务变量或正式模块一端口。
INVALIDITY_ENV=test
INVALIDITY_PORT=5209
INVALIDITY_DATABASE_URL=postgresql+psycopg2://patent:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:5432/patent
INVALIDITY_DATABASE_SCHEMA=invalidity_test
INVALIDITY_ARTIFACT_ROOT=/Users/xiexiaoxiong/Documents/patent/5-invalidity-search-test/.data/invalidity/test
INVALIDITY_ALLOWED_SOURCE_ROOTS=/Users/xiexiaoxiong/Documents/patent/5-invalidity-search-test/.data/uploads/test
INVALIDITY_PARSER_PORT=5201

INVALIDITY_TEST_API_URL=http://127.0.0.1:5209
INVALIDITY_TEST_API_TOKEN=
INVALIDITY_TEST_PARSER_TOKEN=
INVALIDITY_TEST_MODULE1_API_URL=http://127.0.0.1:5201/run
# 专利候选发现统一使用智慧芽；缺少测试 Key 时拒绝启动，不回落其他 provider。
INVALIDITY_TEST_PATENT_PROVIDER=patsnap
INVALIDITY_TEST_PATSNAP_API_KEY=
INVALIDITY_TEST_PATSNAP_BASE_URL=https://connect.zhihuiya.com
INVALIDITY_TEST_PATSNAP_COUNT_PATH=/search/patent/query-search-count/v2
INVALIDITY_TEST_PATSNAP_SEARCH_PATH=/search/patent/query-search-patent/v2
# EPO OPS 不参与检索；必须配置同环境 OAuth 凭据，按智慧芽公开号精确取回官方完整文档。
INVALIDITY_TEST_EPO_OPS_KEY=
INVALIDITY_TEST_EPO_OPS_SECRET=
INVALIDITY_TEST_NPL_PROVIDER=arxiv
INVALIDITY_TEST_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
INVALIDITY_TEST_LLM_API_KEY=REPLACE_WITH_TEST_ONLY_GLM_KEY
INVALIDITY_TEST_LLM_MODEL=glm-4.6v
# GLM 总预算、单个直连地址的生成预算、发送正文前的连通性探测预算（秒）。
INVALIDITY_LLM_TIMEOUT_SECONDS=360
INVALIDITY_LLM_DIRECT_ATTEMPT_TIMEOUT_SECONDS=180
INVALIDITY_LLM_DIRECT_PROBE_TIMEOUT_SECONDS=5
INVALIDITY_I2_LLM_TIMEOUT_SECONDS=120
INVALIDITY_I2_LLM_DIRECT_ATTEMPT_TIMEOUT_SECONDS=105

INVALIDITY_MAX_ROUNDS=5
INVALIDITY_MAX_CANDIDATES_PER_QUERY=5
INVALIDITY_WORKER_POLL_SECONDS=2
INVALIDITY_JOB_LEASE_SECONDS=900
INVALIDITY_SOURCE_FETCH_TIMEOUT_SECONDS=30
INVALIDITY_SOURCE_MAX_BYTES=52428800
INVALIDITY_IMAGE_MAX_BYTES=15728640
INVALIDITY_SOURCE_MAX_REDIRECTS=5
